From: grislux55 <jebchou.hg@gmail.com>
Subject: [PATCH] net: airoha: tune QDMA ring depths, NAPI budgets, and PPE aging

Tune default QDMA descriptor ring depths for 512 MB AN7581 targets
(rx_ring_size=2048, lro_rx_ring_size=64, tx_ring_size=2048), increase
RX/TX NAPI poll weights to 128 without triggering netif_napi_add_weight
warnings, and align default PPE UDP aging with NF_FLOW_TIMEOUT (30s).

Expose module parameters and runtime /sys/kernel/debug/ppe/{aging,napi_budget}
controls.

Signed-off-by: grislux55 <jebchou.hg@gmail.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -29,6 +29,29 @@
 MODULE_PARM_DESC(lro_shared_qdma,
 		 "Allow LRO on QDMA blocks shared by multiple netdevs");
 
+static unsigned int rx_ring_size = 2048;
+module_param(rx_ring_size, uint, 0444);
+MODULE_PARM_DESC(rx_ring_size,
+		 "QDMA RX queue 0 descriptor ring size (256-4096)");
+
+static unsigned int lro_rx_ring_size = 64;
+module_param(lro_rx_ring_size, uint, 0444);
+MODULE_PARM_DESC(lro_rx_ring_size,
+		 "QDMA LRO RX queue descriptor ring size (32-256)");
+
+static unsigned int tx_ring_size = 2048;
+module_param(tx_ring_size, uint, 0444);
+MODULE_PARM_DESC(tx_ring_size,
+		 "QDMA TX queue descriptor ring size (256-4096)");
+
+static unsigned int rx_napi_weight = 128;
+module_param(rx_napi_weight, uint, 0644);
+MODULE_PARM_DESC(rx_napi_weight, "QDMA RX NAPI poll weight (16-256)");
+
+static unsigned int tx_napi_weight = 128;
+module_param(tx_napi_weight, uint, 0644);
+MODULE_PARM_DESC(tx_napi_weight, "QDMA TX NAPI poll weight (16-256)");
+
 u32 airoha_rr(void __iomem *base, u32 offset)
 {
 	return readl(base + offset);
@@ -1240,6 +1263,8 @@
 	q->buf_size = lro_q ? pp_params.max_len : pp_params.max_len / 2;
 	q->ndesc = ndesc;
 	netif_napi_add(eth->napi_dev, &q->napi, airoha_qdma_rx_napi_poll);
+	WRITE_ONCE(q->napi.weight,
+		   clamp_t(unsigned int, READ_ONCE(rx_napi_weight), 16, 256));
 
 	airoha_qdma_wr(qdma, REG_RX_RING_BASE(qid), dma_addr);
 	airoha_qdma_rmw(qdma, REG_RX_RING_SIZE(qid),
@@ -1306,15 +1331,22 @@
 	int i;
 
 	for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++) {
-		int err;
+		int err, ndesc;
 
 		if (!(RX_DONE_INT_MASK & BIT(i))) {
 			/* rx-queue not binded to irq */
 			continue;
 		}
 
-		err = airoha_qdma_init_rx_queue(&qdma->q_rx[i], qdma,
-						RX_DSCP_NUM(i));
+		if (i == 0)
+			ndesc = clamp_t(unsigned int, rx_ring_size, 256, 4096);
+		else if (AIROHA_RXQ_LRO_EN_MASK & BIT(i))
+			ndesc = clamp_t(unsigned int, lro_rx_ring_size,
+					32, 256);
+		else
+			ndesc = RX_DSCP_NUM(i);
+
+		err = airoha_qdma_init_rx_queue(&qdma->q_rx[i], qdma, ndesc);
 		if (err)
 			return err;
 	}
@@ -1582,6 +1614,8 @@
 
 	netif_napi_add_tx(eth->napi_dev, &irq_q->napi,
 			  airoha_qdma_tx_napi_poll);
+	WRITE_ONCE(irq_q->napi.weight,
+		   clamp_t(unsigned int, READ_ONCE(tx_napi_weight), 16, 256));
 
 	airoha_qdma_wr(qdma, REG_TX_IRQ_BASE(id), dma_addr);
 	airoha_qdma_rmw(qdma, REG_TX_IRQ_CFG(id), TX_IRQ_DEPTH_MASK,
@@ -1594,6 +1628,7 @@
 
 static int airoha_qdma_init_tx(struct airoha_qdma *qdma)
 {
+	int tx_ndesc = clamp_t(unsigned int, tx_ring_size, 256, 4096);
 	int i, err;
 
 	for (i = 0; i < ARRAY_SIZE(qdma->q_tx_irq); i++) {
@@ -1605,7 +1640,7 @@
 
 	for (i = 0; i < ARRAY_SIZE(qdma->q_tx); i++) {
 		err = airoha_qdma_init_tx_queue(&qdma->q_tx[i], qdma,
-						TX_DSCP_NUM);
+						tx_ndesc);
 		if (err)
 			return err;
 	}
@@ -1613,6 +1648,41 @@
 	return 0;
 }
 
+void airoha_eth_get_napi_budget(struct airoha_eth *eth,
+				unsigned int *rx_weight,
+				unsigned int *tx_weight)
+{
+	*rx_weight = clamp_t(unsigned int, READ_ONCE(rx_napi_weight), 16, 256);
+	*tx_weight = clamp_t(unsigned int, READ_ONCE(tx_napi_weight), 16, 256);
+}
+
+void airoha_eth_set_napi_budget(struct airoha_eth *eth,
+				unsigned int rx_weight,
+				unsigned int tx_weight)
+{
+	int i, j;
+
+	rx_weight = clamp_t(unsigned int, rx_weight, 16, 256);
+	tx_weight = clamp_t(unsigned int, tx_weight, 16, 256);
+	WRITE_ONCE(rx_napi_weight, rx_weight);
+	WRITE_ONCE(tx_napi_weight, tx_weight);
+
+	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
+		struct airoha_qdma *qdma = &eth->qdma[i];
+
+		for (j = 0; j < ARRAY_SIZE(qdma->q_rx); j++) {
+			if (qdma->q_rx[j].ndesc)
+				WRITE_ONCE(qdma->q_rx[j].napi.weight,
+					   rx_weight);
+		}
+		for (j = 0; j < ARRAY_SIZE(qdma->q_tx_irq); j++) {
+			if (qdma->q_tx_irq[j].size)
+				WRITE_ONCE(qdma->q_tx_irq[j].napi.weight,
+					   tx_weight);
+		}
+	}
+}
+
 static void airoha_qdma_tx_cleanup(struct airoha_qdma *qdma)
 {
 	u32 status;
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -857,6 +857,16 @@
 extern bool airoha_pon_pbit_ib2_pcp;
 void airoha_ppe_remove_egress_flows(struct airoha_gdm_dev *dev);
 void airoha_ppe_flush_pon_flows(struct airoha_eth *eth);
+void airoha_eth_get_napi_budget(struct airoha_eth *eth,

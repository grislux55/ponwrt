From: grislux55 <jebchou.hg@gmail.com>
Subject: [PATCH] watchdog: airoha: expose max_hw_heartbeat_ms for >24s timeouts

On AN7581 the watchdog timer ticks at 175 MHz (half of the 350 MHz bus
clock), capping the 32-bit reload counter at 24 seconds. Reporting that
hardware ceiling via max_timeout causes WDIOC_SETTIMEOUT(30) from OpenWrt
init and procd to fail with -EINVAL.

Report the hardware ceiling via max_hw_heartbeat_ms and clamp the counter
reload value in airoha_wdt_start() so the Linux watchdog core bridges
longer userspace timeouts with internal worker keepalives.

Signed-off-by: grislux55 <jebchou.hg@gmail.com>
---
--- a/drivers/watchdog/airoha_wdt.c
+++ b/drivers/watchdog/airoha_wdt.c
@@ -19,6 +19,7 @@
 #include <linux/math.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/time64.h>
 #include <linux/watchdog.h>
 
 /* Base address of timer and watchdog registers */
@@ -54,12 +55,15 @@ MODULE_PARM_DESC(nowayout, "Watchdog cannot be stopped once started (default="
 static int airoha_wdt_start(struct watchdog_device *wdog_dev)
 {
 	struct airoha_wdt_desc *airoha_wdt = watchdog_get_drvdata(wdog_dev);
+	unsigned int hw_timeout;
 	u32 val;
 
 	val = readl(airoha_wdt->base + TIMER_CTRL);
 	val |= (WDT_TIMER_ENABLE | WDT_ENABLE | WDT_TIMER_INTERRUPT);
 	writel(val, airoha_wdt->base + TIMER_CTRL);
-	val = wdog_dev->timeout * airoha_wdt->wdt_freq;
+	hw_timeout = min_t(unsigned int, wdog_dev->timeout,
+			   wdog_dev->max_hw_heartbeat_ms / MSEC_PER_SEC);
+	val = hw_timeout * airoha_wdt->wdt_freq;
 	writel(val, airoha_wdt->base + WDT_TIMER_LOAD_VALUE);
 
 	return 0;
@@ -129,6 +133,7 @@ static int airoha_wdt_probe(struct platform_device *pdev)
 	struct airoha_wdt_desc *airoha_wdt;
 	struct watchdog_device *wdog_dev;
 	struct device *dev = &pdev->dev;
+	unsigned int max_hw_timeout;
 	struct clk *bus_clk;
 	int ret;
 
@@ -151,13 +156,19 @@ static int airoha_wdt_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, -EINVAL,
 				     "invalid clock frequency\n");
 
+	max_hw_timeout = FIELD_MAX(WDT_TIMER_VAL) / airoha_wdt->wdt_freq;
+	if (!max_hw_timeout)
+		return dev_err_probe(dev, -EINVAL,
+				     "watchdog clock rate too high\n");
+
 	/* Initialize struct watchdog device */
 	wdog_dev = &airoha_wdt->wdog_dev;
+	wdog_dev->min_timeout = 1;
 	wdog_dev->timeout = heartbeat;
 	wdog_dev->info = &airoha_wdt_info;
 	wdog_dev->ops = &airoha_wdt_ops;
 	/* Bus 300MHz, watchdog 150MHz, 28 seconds */
-	wdog_dev->max_timeout = FIELD_MAX(WDT_TIMER_VAL) / airoha_wdt->wdt_freq;
+	wdog_dev->max_hw_heartbeat_ms = max_hw_timeout * MSEC_PER_SEC;
 	wdog_dev->parent = dev;
 
 	watchdog_set_drvdata(wdog_dev, airoha_wdt);

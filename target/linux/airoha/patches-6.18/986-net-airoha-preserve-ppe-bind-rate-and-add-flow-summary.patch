+static int airoha_ppe_debugfs_summary_show(struct seq_file *m, void *private)
+{
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_ppe_flow_summary sum;
+
+	airoha_ppe_get_flow_summary(ppe, &sum);
+	seq_printf(m,
+		   "total=%u bind=%u unbind=%u fin=%u l2b=%u ipv4=%u ipv6=%u hw_init=%u\n",
+		   sum.total, sum.bind, sum.unbind, sum.fin,
+		   sum.l2b, sum.ipv4, sum.ipv6, sum.hw_init);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_summary);

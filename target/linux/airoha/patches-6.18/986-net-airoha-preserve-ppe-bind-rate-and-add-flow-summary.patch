+			      1, 0xffff);
 	u16 non_l4 = clamp_t(unsigned int, READ_ONCE(ppe_age_non_l4),
 			     1, 0x7fff);
 	u16 udp = clamp_t(unsigned int, READ_ONCE(ppe_age_udp), 1, 0x7fff);
@@ -265,11 +322,7 @@
 			      FIELD_PREP(PPE_DRAM_TB_NUM_ENTRY_MASK,
 					 dram_num_entries));
 
-		airoha_fe_rmw(eth, REG_PPE_BIND_RATE(i),
-			      PPE_BIND_RATE_L2B_BIND_MASK |
-			      PPE_BIND_RATE_BIND_MASK,
-			      FIELD_PREP(PPE_BIND_RATE_L2B_BIND_MASK, 0x1e) |
-			      FIELD_PREP(PPE_BIND_RATE_BIND_MASK, 0x1e));
+		airoha_ppe_program_bind_rate(eth, i, bind_l2b, bind_l3);
 
 		airoha_fe_wr(eth, REG_PPE_HASH_SEED(i), PPE_HASH_SEED);
 		airoha_fe_clear(eth, REG_PPE_PPE_FLOW_CFG(i),
@@ -1096,6 +1149,77 @@
 	}
 }
 
+void airoha_ppe_get_flow_summary(struct airoha_ppe *ppe,
+				 struct airoha_ppe_flow_summary *sum)
+{
+	struct airoha_eth *eth = ppe->eth;
+	struct airoha_flow_table_entry *e;
+	struct rhashtable_iter iter;
+
+	memset(sum, 0, sizeof(*sum));
+	sum->hw_init = !!rcu_access_pointer(eth->npu);
+
+	mutex_lock(&flow_offload_mutex);
+	rhashtable_walk_enter(&eth->flow_table, &iter);
+	rhashtable_walk_start(&iter);
+	while ((e = rhashtable_walk_next(&iter))) {
+		u32 ib1, pkt_type, state;
+
+		if (IS_ERR(e))
+			continue;
+
+		if (READ_ONCE(e->type) == FLOW_TYPE_L2) {
+			struct airoha_flow_table_entry *sub;
+			bool has_sub = false;
+
+			spin_lock_bh(&ppe_lock);
+			hlist_for_each_entry(sub, &e->l2_flows,
+					     l2_subflow_node) {
+				has_sub = true;
+				sum->total++;
+				sum->l2b++;
+				if (READ_ONCE(sub->hash) != 0xffff)
+					sum->bind++;
+				else
+					sum->unbind++;
+			}
+			spin_unlock_bh(&ppe_lock);
+
+			if (!has_sub) {
+				sum->total++;
+				sum->l2b++;
+				sum->unbind++;
+			}
+			continue;
+		}
+
+		sum->total++;
+		ib1 = READ_ONCE(e->data.ib1);
+		pkt_type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, ib1);
+		if (pkt_type == PPE_PKT_TYPE_BRIDGE)
+			sum->l2b++;
+		else if (pkt_type >= PPE_PKT_TYPE_IPV6_ROUTE_3T)
+			sum->ipv6++;
+		else
+			sum->ipv4++;
+
+		if (READ_ONCE(e->hash) == 0xffff) {
+			sum->unbind++;
+		} else {
+			state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, ib1);
+			if (state == AIROHA_FOE_STATE_FIN)
+				sum->fin++;
+			else if (state == AIROHA_FOE_STATE_BIND)
+				sum->bind++;
+			else
+				sum->unbind++;
+		}
+	}
+	rhashtable_walk_stop(&iter);
+	rhashtable_walk_exit(&iter);
+	mutex_unlock(&flow_offload_mutex);
+}
+
 void airoha_ppe_flush_pon_flows(struct airoha_eth *eth)

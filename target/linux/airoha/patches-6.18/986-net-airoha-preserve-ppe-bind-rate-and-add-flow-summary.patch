From: grislux55 <jebchou.hg@gmail.com>
Subject: [PATCH] net: airoha: preserve PPE bind_rate across hw_init and add summary debugfs

airoha_ppe_offload_setup() runs lazily on the first offloaded flow and invokes
airoha_ppe_hw_init(), which wrote a hardcoded 0x1e threshold back to
REG_PPE_BIND_RATE and overwrote values written earlier via ppe/bind_rate.

Store the configured L2B and L3 bind-rate thresholds in module parameters and
apply them inside airoha_ppe_hw_init(). Add a software-indexed ppe/summary
debugfs file backed by eth->flow_table so telemetry readers avoid scanning all
16K SRAM FOE slots under ppe_lock via REG_PPE_RAM_CTRL.

Signed-off-by: grislux55 <jebchou.hg@gmail.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -877,10 +877,26 @@
 void airoha_eth_set_napi_budget(struct airoha_eth *eth,
 				unsigned int rx_weight,
 				unsigned int tx_weight);
+struct airoha_ppe_flow_summary {
+	u32 total;
+	u32 bind;
+	u32 unbind;
+	u32 fin;
+	u32 l2b;
+	u32 ipv4;
+	u32 ipv6;
+	bool hw_init;
+};
+
 void airoha_ppe_get_aging(struct airoha_ppe *ppe, u16 *non_l4, u16 *udp,
 			  u16 *tcp, u16 *tcp_fin);
 void airoha_ppe_set_aging(struct airoha_ppe *ppe, u16 non_l4, u16 udp,
 			  u16 tcp, u16 tcp_fin);
+void airoha_ppe_get_bind_rate(struct airoha_ppe *ppe, int index,
+			      u16 *l2b, u16 *l3);
+void airoha_ppe_set_bind_rate(struct airoha_ppe *ppe, u16 l2b, u16 l3);
+void airoha_ppe_get_flow_summary(struct airoha_ppe *ppe,
+				 struct airoha_ppe_flow_summary *sum);
 bool airoha_ppe_is_enabled(struct airoha_eth *eth, int index);
 void airoha_ppe_check_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
 			  u16 hash, bool rx_wlan);

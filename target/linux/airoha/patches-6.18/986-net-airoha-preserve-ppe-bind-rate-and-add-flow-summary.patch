 }
 
+static void airoha_ppe_program_bind_rate(struct airoha_eth *eth, int index,
+					 u16 l2b, u16 l3)
+{
+	airoha_fe_rmw(eth, REG_PPE_BIND_RATE(index),
+		      PPE_BIND_RATE_L2B_BIND_MASK | PPE_BIND_RATE_BIND_MASK,
+		      FIELD_PREP(PPE_BIND_RATE_L2B_BIND_MASK, l2b) |
+		      FIELD_PREP(PPE_BIND_RATE_BIND_MASK, l3));
+}
+
+void airoha_ppe_get_bind_rate(struct airoha_ppe *ppe, int index,
+			      u16 *l2b, u16 *l3)
+{
+	struct airoha_eth *eth = ppe->eth;
+	u32 rate;
+
+	if (!rcu_access_pointer(eth->npu)) {
+		*l2b = clamp_t(unsigned int, READ_ONCE(ppe_bind_rate_l2b),
+			       1, 0xffff);
+		*l3 = clamp_t(unsigned int, READ_ONCE(ppe_bind_rate_l3),
+			      1, 0xffff);
+		return;
+	}
+
+	rate = airoha_fe_rr(eth, REG_PPE_BIND_RATE(index));
+	*l2b = FIELD_GET(PPE_BIND_RATE_L2B_BIND_MASK, rate);
+	*l3 = FIELD_GET(PPE_BIND_RATE_BIND_MASK, rate);
+}
+
+void airoha_ppe_set_bind_rate(struct airoha_ppe *ppe, u16 l2b, u16 l3)
+{
+	struct airoha_eth *eth = ppe->eth;
+	int i;
+
+	l2b = max_t(u16, l2b, 1);
+	l3 = max_t(u16, l3, 1);
+
+	WRITE_ONCE(ppe_bind_rate_l2b, l2b);
+	WRITE_ONCE(ppe_bind_rate_l3, l3);
+
+	for (i = 0; i < eth->soc->num_ppe; i++)
+		airoha_ppe_program_bind_rate(eth, i, l2b, l3);
+}
+

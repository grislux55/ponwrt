#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

[ -r /etc/openwrt_release ] || exit 0
# shellcheck disable=SC1091
. /etc/openwrt_release

[ "${DISTRIB_ID:-}" = "NNRRWrt" ] || exit 0

fresh_system=0
cur_hostname="$(uci -q get system.@system[0].hostname || true)"
case "$cur_hostname" in
	""|"ponwrt"|"PonWrt"|"ImmortalWrt"|"OpenWrt")
		uci set system.@system[0].hostname='NNRRWrt'
		fresh_system=1
		;;
esac

cur_zonename="$(uci -q get system.@system[0].zonename || true)"
cur_timezone="$(uci -q get system.@system[0].timezone || true)"
case "$cur_zonename:$cur_timezone" in
	:|UTC:|UTC:GMT0|UTC:UTC|:GMT0|:UTC)
		uci set system.@system[0].zonename='Asia/Shanghai'
		uci set system.@system[0].timezone='CST-8'
		;;
esac

if [ -f /etc/config/irqbalance ]; then
	cur_irqb="$(uci -q get irqbalance.irqbalance.enabled || true)"
	if [ "$fresh_system" -eq 1 ] && [ "${cur_irqb:-0}" = "0" ]; then
		uci set irqbalance.irqbalance.enabled='1'
	fi
fi

if [ -f /etc/config/uhttpd ]; then
	cur_cn="$(uci -q get uhttpd.defaults.commonname || true)"
	case "$cur_cn" in
		""|"%D"|"OpenWrt"|"ImmortalWrt"|"PonWrt")
			uci set uhttpd.defaults.commonname='NNRRWrt'
			;;
	esac

	cur_redir="$(uci -q get uhttpd.main.redirect_https || true)"
	if [ -z "$cur_redir" ] || [ "$fresh_system" -eq 1 ]; then
		uci set uhttpd.main.redirect_https='0'
	fi

	if [ -f /lib/libustream-ssl.so ] && { [ -x /usr/sbin/px5g ] || [ -x /usr/bin/openssl ]; }; then
		cur_https="$(uci -q get uhttpd.main.listen_https || true)"
		if [ -z "$cur_https" ] && { [ "$fresh_system" -eq 1 ] || [ ! -s /etc/uhttpd.crt ]; }; then
			uci add_list uhttpd.main.listen_https='0.0.0.0:443'
			uci add_list uhttpd.main.listen_https='[::]:443'
		fi
	fi
fi

backfill_board_leds() {
	local board_file="/etc/board.json"
	local cur_board=""
	local existing_sysfs=""
	local led_keys=""
	local led_id=""

	[ -r /tmp/sysinfo/board_name ] && cur_board="$(cat /tmp/sysinfo/board_name)"
	if [ -x /bin/board_detect ]; then
		if [ ! -s "$board_file" ]; then
			/bin/board_detect || true
		elif [ "$cur_board" = "nokia,xg-040g-md-ubi" ] && ! grep -q '"mt7530-0:0f:green:lan-1"' "$board_file" 2>/dev/null; then
			/bin/board_detect -f || true
		fi
	fi

	[ -s "$board_file" ] || return 0
	[ -r /usr/share/libubox/jshn.sh ] || return 0

	# shellcheck disable=SC1091
	. /usr/share/libubox/jshn.sh

	json_init
	json_load_file "$board_file" 2>/dev/null || return 0
	if ! json_is_a led object; then
		json_cleanup
		return 0
	fi

	existing_sysfs="$(uci -q show system | sed -n "s/^system\\.[^.]*\\.sysfs='\\(.*\\)'$/\\1/p")"

	json_select led
	json_get_keys led_keys
	for led_id in $led_keys; do
		local cfg="led_$led_id"
		local name="" sysfs="" type="" trigger="" default=""

		json_select "$led_id"
		json_get_vars name sysfs type trigger default

		if [ -n "$sysfs" ] && \
		   ! printf '%s\n' "$existing_sysfs" | grep -qxF "$sysfs" && \
		   ! uci -q get "system.$cfg" >/dev/null; then
			uci set "system.$cfg=led"
			[ -n "$name" ] && uci set "system.$cfg.name=$name"
			uci set "system.$cfg.sysfs=$sysfs"
			[ -n "$trigger" ] && uci set "system.$cfg.trigger=$trigger"
			[ -n "$default" ] && uci set "system.$cfg.default=$default"

			case "$type" in
				netdev)
					local device="" mode=""
					json_get_vars device mode
					uci set "system.$cfg.trigger=netdev"
					[ -n "$device" ] && uci set "system.$cfg.dev=$device"
					[ -n "$mode" ] && uci set "system.$cfg.mode=$mode"
					;;
				usbport)
					local port=""
					unset ports
					json_get_values ports ports
					uci set "system.$cfg.trigger=usbport"
					for port in $ports; do
						uci add_list "system.$cfg.port=$port"
					done
					unset ports
					;;
				timer|oneshot)
					local delayon="" delayoff=""
					json_get_vars delayon delayoff
					uci set "system.$cfg.trigger=$type"
					[ -n "$delayon" ] && uci set "system.$cfg.delayon=$delayon"
					[ -n "$delayoff" ] && uci set "system.$cfg.delayoff=$delayoff"
					;;
				gpio)
					local gpio="" inverted=""
					json_get_vars gpio inverted
					uci set "system.$cfg.trigger=gpio"
					[ -n "$gpio" ] && uci set "system.$cfg.gpio=$gpio"
					[ -n "$inverted" ] && uci set "system.$cfg.inverted=$inverted"
					;;
			esac

			existing_sysfs="$existing_sysfs
$sysfs"
		fi

		json_select ..
	done
	json_select ..
	json_cleanup
}

disable_unconfigured_tailscale() {
	[ -f /etc/config/tailscale ] || return 0

	local ts_dirty=0
	local ts_enabled=""
	local ts_state=""

	ts_enabled="$(uci -q get tailscale.settings.service_enabled || true)"
	ts_state="$(uci -q get tailscale.settings.state_file || true)"
	[ -n "$ts_state" ] || ts_state="/etc/tailscale/tailscaled.state"

	if [ -z "$ts_enabled" ]; then
		if [ ! -s "$ts_state" ] || ! grep -q '"_profiles"' "$ts_state" 2>/dev/null; then
			uci set tailscale.settings.service_enabled='0'
			if [ -z "$(uci -q get tailscale.settings.dns_mode || true)" ]; then
				uci set tailscale.settings.dns_mode='disabled'
			fi
			ts_enabled="0"
			ts_dirty=1
		fi
	fi

	[ "$ts_dirty" -eq 1 ] && uci commit tailscale

	if [ "$ts_enabled" = "0" ] && [ -x /etc/init.d/tailscale ]; then
		/etc/init.d/tailscale stop >/dev/null 2>&1 || true
		/etc/init.d/tailscale disable >/dev/null 2>&1 || true
	fi
}

disable_unconfigured_ddns() {
	[ -f /etc/config/ddns ] || return 0

	local ddns_dirty=0
	local sec=""
	local ddns_active=0

	for sec in myddns_ipv4 myddns_ipv6; do
		local sec_host="" sec_en=""
		sec_host="$(uci -q get "ddns.$sec.lookup_host" || true)"
		sec_en="$(uci -q get "ddns.$sec.enabled" || true)"
		if [ "$sec_host" = "yourhost.example.com" ]; then
			case "${sec_en:-0}" in
				1|on|true|yes|enabled) ;;
				*)
					uci -q delete "ddns.$sec" || true
					ddns_dirty=1
					;;
			esac
		fi
	done

	[ "$ddns_dirty" -eq 1 ] && uci commit ddns

	for sec in $(uci -q show ddns | sed -n "s/^ddns\\.\\([^.=]*\\)=service$/\\1/p"); do
		case "$(uci -q get "ddns.$sec.enabled" || true)" in
			1|on|true|yes|enabled)
				ddns_active=1
				break
				;;
		esac
	done

	if [ "$ddns_active" -eq 0 ] && [ -x /etc/init.d/ddns ]; then
		/etc/init.d/ddns stop >/dev/null 2>&1 || true
		/etc/init.d/ddns disable >/dev/null 2>&1 || true
	fi
}

backfill_board_leds

uci commit system
[ -f /etc/config/irqbalance ] && uci commit irqbalance
[ -f /etc/config/uhttpd ] && uci commit uhttpd
disable_unconfigured_tailscale
disable_unconfigured_ddns

exit 0

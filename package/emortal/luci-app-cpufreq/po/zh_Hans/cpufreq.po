msgid "<h4>Apply for CPU %s.</h4>"
msgstr "<h4>作用于 CPU %s</h4>"

msgid "CPU Freq"
msgstr "CPU 性能调节"

msgid "CPU Freq Settings"
msgstr "CPU 性能调节"

msgid "CPU Scaling Governor"
msgstr "CPU 工作模式"

msgid "CPU Switching Sampling rate"
msgstr "采样周期倍率"

msgid "CPU Switching Threshold"
msgstr "升频负载阈值"

msgid "CPU stays at the selected frequency in this mode."
msgstr "当前模式下 CPU 固定运行在所选频率。"

msgid "CPU stays at the selected power-saving frequency."
msgstr "省电模式下 CPU 固定运行在所选频率。"

msgid "Configure CPU scaling governor and operating frequencies."
msgstr "配置 CPU 工作模式与运行频率。"

msgid "Expecting: %s"
msgstr "请输入：%s"

msgid "Grant access to CPUFreq configuration"
msgstr "授予访问 CPU 调频配置的权限"

msgid "Kernel make a decision on whether it should increase the frequency (%)"
msgstr "触发升频的 CPU 占用率百分比（%）。"

msgid "Locked CPU Frequency"
msgstr "锁定运行频率"

msgid "Lower frequency bound during idle or light load."
msgstr "空闲或轻载时的运行频率下限。"

msgid "Max CPU Freq cannot be lower than Min CPU Freq."
msgstr "最高运行频率需高于或等于待机最低频率。"

msgid "Maximum Scaling Frequency"
msgstr "最高运行频率"

msgid "Minimum Idle Frequency"
msgstr "待机最低频率"

msgid "Power-Saving CPU Frequency"
msgstr "省电运行频率"

msgid "The sampling rate determines how frequently the governor checks to tune the CPU (ms)"
msgstr "ondemand 模式下的降频采样间隔倍率。"

msgid "Unsupported device!"
msgstr "当前设备暂未启用调频接口"

msgid "Upper frequency bound under load."
msgstr "高负载时的运行频率上限。"

msgid "Your device/kernel does not support CPU frequency scaling."
msgstr "内核未暴露可用的 cpufreq 调频策略。"

msgid "conservative (Stepwise dynamic scaling)"
msgstr "conservative（渐进动态调频）"

msgid "ondemand (Threshold-triggered scaling)"
msgstr "ondemand（按占用阈值调频）"

msgid "performance (Lock target frequency)"
msgstr "performance（锁定目标频率）"

msgid "powersave (Lock power-saving frequency)"
msgstr "powersave（锁定省电频率）"

msgid "schedutil (Load-guided dynamic scaling)"
msgstr "schedutil（按负载动态调频）"

msgid "userspace (Fixed manual frequency)"
msgstr "userspace（手动指定频率）"
